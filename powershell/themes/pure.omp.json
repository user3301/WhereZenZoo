{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "#00afff",
          "template": "{{ .Path }}",
          "options": {
            "home_icon": "~",
            "style": "full"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#f5a623",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#ff5f5f{{ end }}",
            "{{ if gt .Ahead 0 }}#af87ff{{ end }}",
            "{{ if gt .Behind 0 }}#af87ff{{ end }}"
          ],
          "template": " ({{ .HEAD }}{{ if .Working.Changed }} *{{ end }}{{ if .Staging.Changed }} +{{ end }}{{ if gt .Ahead 0 }} ^{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} v{{ .Behind }}{{ end }})",
          "options": {
            "fetch_status": true
          }
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#888888",
          "template": " [{{ .FormattedMs }}]",
          "options": {
            "always_enabled": false,
            "threshold": 500
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "#5faf00",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#ff5f5f{{ end }}"
          ],
          "template": "❯ ",
          "options": {
            "always_enabled": true
          }
        }
      ]
    }
  ]
}
